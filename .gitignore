# 3D source files (blends, fbx, renders) — too large for GitHub (>100MB files).
# Web-ready GLBs/posters are exported to assets/models/ instead.
assets/3d models/
*.blend1
*:Zone.Identifier
# WSL materializes Zone.Identifier ADS as files with a U+F03A char — catch those too
*.Identifier
assets/developer/rheed analysis pipeline.mp4

# Dependencies — never commit
node_modules/
__pycache__/

# Developer source videos — huge originals stay local; web-ready encodes live in assets/developer/web/
assets/developer/*.mp4
assets/developer/*.mov
!assets/developer/web

# Moto vault (moto.html) — media sources stay local; only web derivatives are committed.
# inbox/ is the Studio drop zone, src/ is the per-journey originals archive.
assets/moto/inbox/
assets/moto/src/
# import intermediates: manifest holds volatile Google hostedimage URLs; log is regenerable
assets/moto/manifest.json
assets/moto/manifest_photos.log
